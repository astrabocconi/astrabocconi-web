# Supabase — guides, dispense/handouts, representatives, exchange data, RAG corpus.
# The publishable key is safe in the browser; it is guarded by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://jsuzhbspinevkzmhibop.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS — never expose to the browser, never prefix NEXT_PUBLIC_.
# Needed by the backoffice for privileged writes.
SUPABASE_SECRET_KEY=

# Neon (astra-app's database) — news and events, read-only for this site.
# See docs/ARCHITECTURE.md for why the data lives in two places.
NEON_DATABASE_URL=

# Backoffice first run only. Long random string. The seven click gesture
# reveals the setup form; this is what actually authorises creating the first
# owner account, and it stops working once one operator exists.
ADMIN_BOOTSTRAP_SECRET=
